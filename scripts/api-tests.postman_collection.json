{
  "info": {
    "name": "DPW API Integration Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Run API Suite",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API suite executes', function (done) {",
              "  const baseUrl = (pm.variables.get('baseUrl') || '').replace(/\\/+$/, '');",
              "",
              "  function parseJson(text) {",
              "    try { return JSON.parse(text); } catch (e) { return null; }",
              "  }",
              "",
              "  function send(method, path, options) {",
              "    const opts = options || {};",
              "    const headers = {};",
              "    if (opts.token) headers.Authorization = 'Bearer ' + opts.token;",
              "    if (opts.body !== undefined) headers['Content-Type'] = 'application/json';",
              "",
              "    return new Promise(function (resolve, reject) {",
              "      pm.sendRequest({",
              "        url: baseUrl + path,",
              "        method: method,",
              "        header: headers,",
              "        body: opts.body !== undefined ? { mode: 'raw', raw: typeof opts.body === 'string' ? opts.body : JSON.stringify(opts.body) } : undefined",
              "      }, function (err, res) {",
              "        if (err) return reject(err);",
              "        const text = res.text();",
              "        resolve({",
              "          code: res.code,",
              "          text: text,",
              "          json: parseJson(text)",
              "        });",
              "      });",
              "    });",
              "  }",
              "",
              "  function assertStatus(resp, expected, label) {",
              "    pm.test(label, function () {",
              "      pm.expect(resp.code).to.eql(expected);",
              "    });",
              "    if (resp.code !== expected) throw new Error(label + ' failed: expected ' + expected + ', got ' + resp.code + '. Body: ' + resp.text);",
              "  }",
              "",
              "  function assertStatusIn(resp, expected, label) {",
              "    pm.test(label, function () {",
              "      pm.expect(expected).to.include(resp.code);",
              "    });",
              "    if (!expected.includes(resp.code)) throw new Error(label + ' failed: expected one of ' + expected.join(',') + ', got ' + resp.code + '. Body: ' + resp.text);",
              "  }",
              "",
              "  function assertTruthy(value, label, details) {",
              "    pm.test(label, function () {",
              "      pm.expect(Boolean(value)).to.eql(true);",
              "    });",
              "    if (!value) throw new Error(label + ' failed: ' + (details || 'empty value'));",
              "  }",
              "",
              "  const protectedRoutes = [",
              "    ['GET', '/admin/maintenance'],",
              "    ['PUT', '/admin/maintenance', {}],",
              "    ['GET', '/me'],",
              "    ['PATCH', '/me', {}],",
              "    ['GET', '/users'],",
              "    ['GET', '/my-permissions'],",
              "    ['GET', '/notifications'],",
              "    ['PATCH', '/notifications/00000000-0000-0000-0000-000000000000/read'],",
              "    ['POST', '/notifications/read-all'],",
              "    ['POST', '/push/subscriptions', {}],",
              "    ['DELETE', '/push/subscriptions', {}],",
              "    ['PATCH', '/admin/users/00000000-0000-0000-0000-000000000000', {}],",
              "    ['DELETE', '/admin/users/00000000-0000-0000-0000-000000000000'],",
              "    ['GET', '/admin/roles'],",
              "    ['POST', '/admin/roles', {}],",
              "    ['POST', '/admin/roles/reorder', {}],",
              "    ['POST', '/admin/roles/nonexistent/move', {}],",
              "    ['PATCH', '/admin/roles/nonexistent', {}],",
              "    ['DELETE', '/admin/roles/nonexistent'],",
              "    ['GET', '/admin/departments'],",
              "    ['GET', '/admin/midata-status'],",
              "    ['GET', '/admin/container-logs'],",
              "    ['GET', '/admin/app-settings'],",
              "    ['PUT', '/admin/app-settings/nonexistent', {}],",
              "    ['POST', '/admin/reset-azure-auth'],",
              "    ['POST', '/admin/departments', {}],",
              "    ['PATCH', '/admin/departments/nonexistent', {}],",
              "    ['DELETE', '/admin/departments/nonexistent'],",
              "    ['GET', '/admin/role-permissions'],",
              "    ['PUT', '/admin/role-permissions', {}],",
              "    ['GET', '/admin/role-dept-access'],",
              "    ['PUT', '/admin/role-dept-access', {}],",
              "    ['GET', '/admin/activities/trash'],",
              "    ['POST', '/admin/activities/00000000-0000-0000-0000-000000000000/restore'],",
              "    ['GET', '/departments'],",
              "    ['GET', '/activities'],",
              "    ['POST', '/activities', {}],",
              "    ['GET', '/locations'],",
              "    ['GET', '/admin/locations'],",
              "    ['POST', '/admin/locations', {}],",
              "    ['PATCH', '/admin/locations/00000000-0000-0000-0000-000000000000', {}],",
              "    ['DELETE', '/admin/locations/00000000-0000-0000-0000-000000000000'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/attachments'],",
              "    ['POST', '/activities/00000000-0000-0000-0000-000000000000/attachments', {}],",
              "    ['GET', '/attachments/00000000-0000-0000-0000-000000000000/download'],",
              "    ['DELETE', '/attachments/00000000-0000-0000-0000-000000000000'],",
              "    ['POST', '/activities/00000000-0000-0000-0000-000000000000/share'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/share'],",
              "    ['DELETE', '/activities/00000000-0000-0000-0000-000000000000/share'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/midata/children-count'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/midata-children-count'],",
              "    ['GET', '/midata/children-counts'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/weather-location'],",
              "    ['PUT', '/activities/00000000-0000-0000-0000-000000000000/weather-location', {}],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/weather-expected'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000'],",
              "    ['PATCH', '/activities/00000000-0000-0000-0000-000000000000', {}],",
              "    ['DELETE', '/activities/00000000-0000-0000-0000-000000000000'],",
              "    ['GET', '/mail-templates'],",
              "    ['GET', '/mail-templates/nonexistent'],",
              "    ['PUT', '/mail-templates/nonexistent', {}],",
              "    ['GET', '/event-templates'],",
              "    ['GET', '/event-templates/nonexistent'],",
              "    ['PUT', '/event-templates/nonexistent', {}],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/event-publication'],",
              "    ['PUT', '/activities/00000000-0000-0000-0000-000000000000/event-publication', {}],",
              "    ['DELETE', '/activities/00000000-0000-0000-0000-000000000000/event-publication'],",
              "    ['POST', '/send-mail', {}],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/mail-context'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/sent-mails'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/mail-draft'],",
              "    ['PUT', '/activities/00000000-0000-0000-0000-000000000000/mail-draft', {}],",
              "    ['DELETE', '/activities/00000000-0000-0000-0000-000000000000/mail-draft'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/form-draft'],",
              "    ['PUT', '/activities/00000000-0000-0000-0000-000000000000/form-draft', {}],",
              "    ['DELETE', '/activities/00000000-0000-0000-0000-000000000000/form-draft'],",
              "    ['POST', '/bug-report', {}],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/form'],",
              "    ['POST', '/activities/00000000-0000-0000-0000-000000000000/form', {}],",
              "    ['PUT', '/activities/00000000-0000-0000-0000-000000000000/form', {}],",
              "    ['DELETE', '/activities/00000000-0000-0000-0000-000000000000/form'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/form/responses'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/form/responses/00000000-0000-0000-0000-000000000000'],",
              "    ['DELETE', '/activities/00000000-0000-0000-0000-000000000000/form/responses/00000000-0000-0000-0000-000000000000'],",
              "    ['GET', '/activities/00000000-0000-0000-0000-000000000000/form/stats'],",
              "    ['GET', '/form-templates'],",
              "    ['POST', '/form-templates', {}],",
              "    ['PUT', '/form-templates/00000000-0000-0000-0000-000000000000', {}],",
              "    ['DELETE', '/form-templates/00000000-0000-0000-0000-000000000000'],",
              "    ['GET', '/ideaBox'],",
              "    ['POST', '/ideaBox', {}],",
              "    ['PUT', '/ideaBox/00000000-0000-0000-0000-000000000000', {}],",
              "    ['DELETE', '/ideaBox/00000000-0000-0000-0000-000000000000']",
              "  ];",
              "",
              "  (async function () {",
              "    let resp = await send('GET', '/health');",
              "    assertStatus(resp, 200, 'health endpoint');",
              "",
              "    resp = await send('GET', '/status');",
              "    assertStatus(resp, 200, 'status endpoint');",
              "",
              "    resp = await send('GET', '/activities');",
              "    assertStatus(resp, 401, 'activities require auth');",
              "",
              "    resp = await send('GET', '/activities', { token: 'invalid-token' });",
              "    assertStatus(resp, 401, 'invalid token is rejected');",
              "",
              "    resp = await send('POST', '/auth/me');",
              "    assertStatus(resp, 401, 'auth/me requires bearer token');",
              "",
              "    resp = await send('GET', '/setup/auth-config');",
              "    assertStatusIn(resp, [200, 404], 'setup auth config read');",
              "",
              "    resp = await send('POST', '/setup/auth-config', { body: {} });",
              "    assertStatusIn(resp, [200, 201, 400, 409], 'setup auth config write');",
              "",
              "    resp = await send('GET', '/maintenance');",
              "    assertStatus(resp, 200, 'maintenance status');",
              "",
              "    resp = await send('GET', '/push/vapid-public-key');",
              "    assertStatusIn(resp, [200, 503], 'push vapid public key');",
              "",
              "    resp = await send('POST', '/push/payload', { body: {} });",
              "    assertStatus(resp, 400, 'push payload validation');",
              "",
              "    resp = await send('GET', '/shared/nonexistent-token');",
              "    assertStatus(resp, 404, 'shared activity not found');",
              "",
              "    resp = await send('GET', '/forms/nonexistent-slug');",
              "    assertStatus(resp, 404, 'public form not found');",
              "",
              "    resp = await send('POST', '/forms/nonexistent-slug/submit', { body: { answers: [] } });",
              "    assertStatus(resp, 404, 'public form submit not found');",
              "",
              "    for (const entry of protectedRoutes) {",
              "      const method = entry[0];",
              "      const path = entry[1];",
              "      const body = entry.length > 2 ? entry[2] : undefined;",
              "      const pr = await send(method, path, body === undefined ? {} : { body: body });",
              "      if (method === 'POST' && path === '/bug-report') {",
              "        assertStatusIn(pr, [401, 503], method + ' ' + path + ' requires auth');",
              "      } else {",
              "        assertStatus(pr, 401, method + ' ' + path + ' requires auth');",
              "      }",
              "    }",
              "",
              "    resp = await send('GET', '/debug/users');",
              "    assertStatus(resp, 200, 'debug users endpoint');",
              "    const users = resp.json;",
              "    assertTruthy(Array.isArray(users) && users.length > 0, 'debug users available', 'no debug users');",
              "    const debugUser = users.find(function (u) { return u.role === 'admin'; }) || users[0];",
              "    assertTruthy(debugUser && debugUser.id, 'debug user id available', 'missing id');",
              "",
              "    const token = 'debug:' + debugUser.id;",
              "",
              "    resp = await send('POST', '/auth/me', { token: token });",
              "    assertStatus(resp, 200, 'auth/me with debug token');",
              "",
              "    resp = await send('GET', '/me', { token: token });",
              "    assertStatus(resp, 200, 'me endpoint');",
              "    const me = resp.json || {};",
              "    assertTruthy(me.id, 'me.id is set', 'me.id missing');",
              "",
              "    resp = await send('PATCH', '/me', { token: token, body: { time_display_mode: 'invalid-mode' } });",
              "    assertStatus(resp, 400, 'patch me rejects invalid time_display_mode');",
              "",
              "    resp = await send('PATCH', '/me', { token: token, body: { time_display_mode: 'clock', notify_channel_email: false } });",
              "    assertStatus(resp, 200, 'patch me updates preferences');",
              "    assertTruthy(resp.json && resp.json.time_display_mode === 'clock', 'patch me reflected in response', 'wrong time_display_mode');",
              "",
              "    resp = await send('GET', '/users', { token: token });",
              "    assertStatus(resp, 200, 'list users');",
              "    const userList = resp.json || [];",
              "    assertTruthy(Array.isArray(userList) && userList.some(function (u) { return String(u.id || '') === String(me.id || ''); }), 'users list contains current user', 'me missing from /users');",
              "",
              "    resp = await send('GET', '/departments', { token: token });",
              "    assertStatus(resp, 200, 'list departments');",
              "",
              "    resp = await send('GET', '/my-permissions', { token: token });",
              "    assertStatus(resp, 200, 'my-permissions endpoint');",
              "",
              "    resp = await send('GET', '/notifications', { token: token });",
              "    assertStatus(resp, 200, 'notifications list endpoint');",
              "    const notifications = Array.isArray(resp.json) ? resp.json : [];",
              "    if (notifications.length > 0 && notifications[0] && notifications[0].id) {",
              "      const noteId = notifications[0].id;",
              "      const markRead = await send('PATCH', '/notifications/' + noteId + '/read', { token: token });",
              "      assertStatus(markRead, 200, 'mark notification as read');",
              "    } else {",
              "      pm.test('notification read single skipped when list empty', function () { pm.expect(true).to.eql(true); });",
              "    }",
              "",
              "    resp = await send('POST', '/notifications/read-all', { token: token });",
              "    assertStatus(resp, 200, 'mark all notifications as read');",
              "",
              "    resp = await send('POST', '/push/subscriptions', { token: token, body: {} });",
              "    assertStatus(resp, 400, 'push subscription validation');",
              "",
              "    const pushEndpoint = 'https://push.example.test/sub/' + String(Date.now());",
              "    resp = await send('POST', '/push/subscriptions', {",
              "      token: token,",
              "      body: {",
              "        endpoint: pushEndpoint,",
              "        keys: {",
              "          p256dh: 'test-p256dh',",
              "          auth: 'test-auth'",
              "        }",
              "      }",
              "    });",
              "    assertStatus(resp, 200, 'upsert push subscription');",
              "",
              "    resp = await send('DELETE', '/push/subscriptions', { token: token, body: { endpoint: pushEndpoint } });",
              "    assertStatus(resp, 200, 'delete push subscription');",
              "",
              "    resp = await send('GET', '/admin/midata-status', { token: token });",
              "    assertStatus(resp, 200, 'admin midata-status endpoint');",
              "",
              "    resp = await send('GET', '/admin/app-settings', { token: token });",
              "    assertStatus(resp, 200, 'admin app-settings endpoint');",
              "",
              "    resp = await send('GET', '/admin/role-dept-access?role=admin', { token: token });",
              "    assertStatus(resp, 200, 'admin role-dept-access endpoint');",
              "",
              "    resp = await send('GET', '/admin/container-logs', { token: token });",
              "    assertStatusIn(resp, [200, 500], 'admin container logs endpoint');",
              "",
              "    resp = await send('GET', '/admin/roles', { token: token });",
              "    assertStatus(resp, 200, 'admin roles endpoint');",
              "",
              "    resp = await send('GET', '/admin/departments', { token: token });",
              "    assertStatus(resp, 200, 'admin departments endpoint');",
              "",
              "    resp = await send('GET', '/admin/role-permissions', { token: token });",
              "    assertStatus(resp, 200, 'admin role-permissions endpoint');",
              "",
              "    resp = await send('GET', '/admin/activities/trash', { token: token });",
              "    assertStatus(resp, 200, 'admin trash endpoint');",
              "",
              "    resp = await send('GET', '/locations', { token: token });",
              "    assertStatus(resp, 200, 'locations endpoint');",
              "",
              "    resp = await send('GET', '/admin/locations', { token: token });",
              "    assertStatus(resp, 200, 'admin locations endpoint');",
              "",
              "    resp = await send('GET', '/mail-templates', { token: token });",
              "    assertStatus(resp, 200, 'mail templates endpoint');",
              "",
              "    resp = await send('GET', '/event-templates', { token: token });",
              "    assertStatus(resp, 200, 'event templates endpoint');",
              "",
              "    resp = await send('GET', '/form-templates', { token: token });",
              "    assertStatus(resp, 200, 'form templates endpoint');",
              "",
              "    resp = await send('GET', '/ideaBox', { token: token });",
              "    assertStatus(resp, 200, 'ideaBox endpoint');",
              "",
              "    resp = await send('GET', '/activities', { token: token });",
              "    assertStatus(resp, 200, 'list activities');",
              "",
              "    resp = await send('POST', '/activities', { token: token, body: {} });",
              "    assertStatus(resp, 400, 'create activity validation');",
              "",
              "    const now = new Date();",
              "    now.setUTCDate(now.getUTCDate() + 30);",
              "    const futureDate = now.toISOString().slice(0, 10);",
              "    const suffix = String(Math.floor(Date.now() / 1000));",
              "",
              "    resp = await send('POST', '/activities', {",
              "      token: token,",
              "      body: {",
              "        title: 'API Test ' + suffix,",
              "        date: futureDate,",
              "        start_time: '10:00',",
              "        end_time: '11:00',",
              "        goal: 'API test goal',",
              "        location: 'API test location',",
              "        responsible: ['Debug'],",
              "        material: [],",
              "        tn_material: [],",
              "        programs: []",
              "      }",
              "    });",
              "    assertStatus(resp, 201, 'create activity');",
              "    const created = resp.json || {};",
              "    const activityId = created.id;",
              "    assertTruthy(activityId, 'created activity id is set', 'activity id missing');",
              "",
              "    resp = await send('GET', '/activities/' + activityId, { token: token });",
              "    assertStatus(resp, 200, 'get created activity');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/weather-location', { token: token });",
              "    assertStatusIn(resp, [200, 404], 'weather-location read endpoint');",
              "",
              "    resp = await send('PUT', '/activities/' + activityId + '/weather-location', { token: token, body: { location: 'Bern', lat: 46.948, lon: 7.4474 } });",
              "    assertStatusIn(resp, [200, 400], 'weather-location write endpoint');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/weather-expected', { token: token });",
              "    assertStatusIn(resp, [200, 502], 'weather expected endpoint');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/midata/children-count', { token: token });",
              "    assertStatusIn(resp, [200, 404, 502], 'midata children-count endpoint');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/event-publication', { token: token });",
              "    assertStatusIn(resp, [200, 404], 'event publication read endpoint');",
              "",
              "    resp = await send('PUT', '/activities/' + activityId + '/event-publication', { token: token, body: {} });",
              "    assertStatusIn(resp, [200, 400], 'event publication write validation');",
              "",
              "    resp = await send('DELETE', '/activities/' + activityId + '/event-publication', { token: token });",
              "    assertStatusIn(resp, [200, 204, 404], 'event publication delete endpoint');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/mail-context', { token: token });",
              "    assertStatusIn(resp, [200, 404], 'mail context endpoint');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/sent-mails', { token: token });",
              "    assertStatus(resp, 200, 'sent-mails endpoint');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/mail-draft', { token: token });",
              "    assertStatus(resp, 404, 'mail-draft missing before create');",
              "",
              "    resp = await send('PUT', '/activities/' + activityId + '/mail-draft', { token: token, body: { recipients: ['noreply@example.com'], cc: [], subject: 'Draft', body_html: '<p>Draft</p>' } });",
              "    assertStatus(resp, 200, 'upsert mail-draft');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/mail-draft', { token: token });",
              "    assertStatus(resp, 200, 'mail-draft read after upsert');",
              "",
              "    resp = await send('DELETE', '/activities/' + activityId + '/mail-draft', { token: token });",
              "    assertStatus(resp, 200, 'mail-draft delete endpoint');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/form-draft', { token: token });",
              "    assertStatus(resp, 404, 'form-draft missing before create');",
              "",
              "    resp = await send('PUT', '/activities/' + activityId + '/form-draft', { token: token, body: { form_type: 'registration', title: 'Draft Form', questions: [] } });",
              "    assertStatus(resp, 200, 'upsert form-draft');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/form-draft', { token: token });",
              "    assertStatus(resp, 200, 'form-draft read after upsert');",
              "",
              "    resp = await send('DELETE', '/activities/' + activityId + '/form-draft', { token: token });",
              "    assertStatus(resp, 200, 'form-draft delete endpoint');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/share', { token: token });",
              "    if (resp.code === 409) {",
              "      pm.test('share-link checks skipped when public_base_url missing', function () { pm.expect(true).to.eql(true); });",
              "    } else {",
              "      assertStatus(resp, 200, 'get share link');",
              "      let shareToken = resp.json ? resp.json.share_token : null;",
              "      if (!shareToken) {",
              "        resp = await send('POST', '/activities/' + activityId + '/share', { token: token });",
              "        assertStatus(resp, 201, 'create share link');",
              "        shareToken = resp.json ? resp.json.share_token : null;",
              "      }",
              "      assertTruthy(shareToken, 'share token is set', 'share token missing');",
              "      resp = await send('GET', '/shared/' + shareToken);",
              "      assertStatus(resp, 200, 'public shared activity');",
              "      resp = await send('DELETE', '/activities/' + activityId + '/share', { token: token });",
              "      assertStatus(resp, 200, 'delete share link');",
              "      resp = await send('GET', '/activities/' + activityId + '/share', { token: token });",
              "      assertStatus(resp, 200, 'get share link after delete');",
              "      const tokenAfterDelete = resp.json ? resp.json.share_token : null;",
              "      assertTruthy(!tokenAfterDelete, 'share token cleared after delete', 'share token still present');",
              "    }",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/form', { token: token });",
              "    assertStatus(resp, 200, 'get activity form before create');",
              "    assertTruthy(resp.json && resp.json.exists === false, 'form absent before create', 'form unexpectedly exists');",
              "",
              "    resp = await send('POST', '/activities/' + activityId + '/form', { token: token, body: {} });",
              "    assertStatus(resp, 400, 'create form validation');",
              "",
              "    resp = await send('POST', '/activities/' + activityId + '/form', {",
              "      token: token,",
              "      body: {",
              "        form_type: 'registration',",
              "        title: 'API Form Test',",
              "        questions: [{ question_text: 'Name', question_type: 'text_input', is_required: true }]",
              "      }",
              "    });",
              "    assertStatus(resp, 201, 'create activity form');",
              "    const form = resp.json || {};",
              "    const formId = form.id;",
              "    const formPublicSlug = form.public_slug;",
              "    const formQuestionId = Array.isArray(form.questions) && form.questions[0] ? form.questions[0].id : null;",
              "    assertTruthy(formId, 'form id is set', 'form id missing');",
              "    assertTruthy(formPublicSlug, 'form public_slug is set', 'form public_slug missing');",
              "    assertTruthy(formQuestionId, 'form question id is set', 'form question id missing');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/form', { token: token });",
              "    assertStatus(resp, 200, 'get activity form after create');",
              "    assertTruthy(resp.json && resp.json.exists === true, 'form exists after create', 'form missing after create');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/form/stats', { token: token });",
              "    assertStatus(resp, 200, 'get form stats');",
              "",
              "    resp = await send('GET', '/forms/' + formPublicSlug);",
              "    assertStatus(resp, 200, 'get public form');",
              "",
              "    resp = await send('POST', '/forms/' + formPublicSlug + '/submit', { body: { answers: [] } });",
              "    assertStatus(resp, 400, 'public form submit missing required answer');",
              "",
              "    resp = await send('POST', '/forms/' + formPublicSlug + '/submit', {",
              "      body: {",
              "        answers: [{ question_id: formQuestionId, answer_value: 'Tester' }]",
              "      }",
              "    });",
              "    assertStatus(resp, 201, 'public form submit');",
              "    const formResponseId = resp.json ? resp.json.id : null;",
              "    assertTruthy(formResponseId, 'form response id is set', 'response id missing');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/form/responses', { token: token });",
              "    assertStatus(resp, 200, 'list form responses');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/form/responses/' + formResponseId, { token: token });",
              "    assertStatus(resp, 200, 'get single form response');",
              "",
              "    resp = await send('DELETE', '/activities/' + activityId + '/form/responses/' + formResponseId, { token: token });",
              "    assertStatus(resp, 200, 'delete form response');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/form/responses/' + formResponseId, { token: token });",
              "    assertStatus(resp, 404, 'deleted form response not found');",
              "",
              "    resp = await send('DELETE', '/activities/' + activityId + '/form', { token: token });",
              "    assertStatus(resp, 200, 'delete activity form');",
              "",
              "    resp = await send('GET', '/activities/' + activityId + '/form', { token: token });",
              "    assertStatus(resp, 200, 'get activity form after delete');",
              "    assertTruthy(resp.json && resp.json.exists === false, 'form removed', 'form still exists');",
              "",
              "    resp = await send('PATCH', '/activities/' + activityId, {",
              "      token: token,",
              "      body: {",
              "        title: 'API Test Updated ' + suffix,",
              "        date: futureDate,",
              "        start_time: '10:00',",
              "        end_time: '11:30',",
              "        goal: 'Updated goal',",
              "        location: 'Updated location',",
              "        responsible: ['Debug'],",
              "        material: [],",
              "        tn_material: ['Cup'],",
              "        programs: []",
              "      }",
              "    });",
              "    assertStatus(resp, 200, 'update activity');",
              "    assertTruthy(resp.json && resp.json.title === 'API Test Updated ' + suffix, 'update reflected in response', 'title mismatch');",
              "",
              "    resp = await send('DELETE', '/activities/' + activityId, { token: token });",
              "    assertStatusIn(resp, [200, 204], 'delete activity');",
              "",
              "    resp = await send('GET', '/activities/' + activityId, { token: token });",
              "    assertStatus(resp, 404, 'deleted activity not found');",
              "",
              "    resp = await send('GET', '/admin/activities/trash', { token: token });",
              "    assertStatus(resp, 200, 'list trash after delete');",
              "    const trash = Array.isArray(resp.json) ? resp.json : [];",
              "    const inTrash = trash.some(function (entry) {",
              "      return String((entry && entry.id) || '') === String(activityId) || String((entry && entry.activity && entry.activity.id) || '') === String(activityId);",
              "    });",
              "    assertTruthy(inTrash, 'deleted activity appears in trash', 'activity missing in trash');",
              "",
              "    resp = await send('POST', '/admin/activities/' + activityId + '/restore', { token: token });",
              "    assertStatus(resp, 200, 'restore deleted activity');",
              "",
              "    resp = await send('GET', '/activities/' + activityId, { token: token });",
              "    assertStatus(resp, 200, 'restored activity is readable');",
              "",
              "    resp = await send('DELETE', '/activities/' + activityId, { token: token });",
              "    assertStatusIn(resp, [200, 204], 'final delete activity');",
              "",
              "    resp = await send('GET', '/activities/' + activityId, { token: token });",
              "    assertStatus(resp, 404, 'final deleted activity not found');",
              "  })().then(function () {",
              "    done();",
              "  }).catch(function (error) {",
              "    done(error);",
              "  });",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
